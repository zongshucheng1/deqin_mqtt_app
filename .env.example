# 仅部署人员配置公开参数；员工登录页不提供技术设置。
# 正式统一后端HTTPS根地址，不包含 /inout，未提供则正式构建失败。
VITE_API_BASE_URL=
# 使用真实已授权Android客户端ID。仓库.env已经提供当前平台公开值。
VITE_AUTH_CLIENT_ID=
# 企业名称从平台公共/auth/tenant/list发现，多企业由员工选择。
VITE_AUTH_TENANT_MODE=discovery
# 固定客户专用部署才显式选择fixed并设置tenantId，不向员工展示数字编码。
VITE_AUTH_TENANT_ID=
# 必须保持RSA/AES加密，只能预置平台公钥，禁止填私钥或关闭加密。
VITE_AUTH_ENCRYPT=true
VITE_AUTH_RSA_PUBLIC_KEY=
